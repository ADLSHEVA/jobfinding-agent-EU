# Template for Streamlit secrets. DO NOT put real keys here in the repo.
# On Streamlit Community Cloud: paste these (with real values) into the app's
# Settings → Secrets. Locally: copy to .streamlit/secrets.toml (gitignored) if you
# prefer secrets over a .env file. app.py mirrors these into the environment so
# config.py (pydantic-settings) reads them.

LLM_PROVIDER = "deepseek"
LLM_API_KEY = "sk-..."
LLM_BASE_URL = "https://api.deepseek.com"
LLM_MODEL = "deepseek-chat"

EMBEDDING_PROVIDER = "jina"
EMBEDDING_BASE_URL = "https://api.jina.ai/v1"
EMBEDDING_MODEL = "jina-embeddings-v3"
EMBEDDING_API_KEY = "jina_..."

# Brave Search — REQUIRED for Live mode (discovers Swiss companies hiring on ATS
# boards: greenhouse / personio / lever / workday / recruitee).
BRAVE_API_KEY = "BSA..."

# ReliefWeb (Track-B international-organisation jobs, e.g. UN/WHO in Geneva). OPTIONAL
# and org-gated: since 2025-11-01 ReliefWeb only accepts a PRE-APPROVED appname
# (register at https://reliefweb.int/help/api). Leave unset if you don't have one —
# the source is then skipped cleanly. Individuals usually can't register; that's fine.
# RELIEFWEB_APPNAME = "yourorg-jobagent-xxxx"

SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_KEY = "eyJ..."   # service_role key
