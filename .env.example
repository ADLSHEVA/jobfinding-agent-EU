# Copy to .env and fill in. All optional for offline/test runs.

# LLM — DeepSeek (OpenAI-compatible API). Get a key at platform.deepseek.com
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embeddings (semantic CV↔job match). Any OpenAI-protocol endpoint.
# OpenAI: set EMBEDDING_API_KEY. Jina/Voyage/local: also set EMBEDDING_BASE_URL.
# Local key-free option: run ollama and set EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Keyword extraction LLM (cheap/fast, e.g. Mistral) — extracts domain-specific
# search terms from the candidate profile to avoid matching unrelated industries.
# Falls back to heuristic extraction when not configured.
KEYWORD_LLM_API_KEY=
KEYWORD_LLM_BASE_URL=https://api.mistral.ai/v1
KEYWORD_LLM_MODEL=mistral-small-latest

# Persistence (Supabase Postgres + pgvector)
SUPABASE_URL=
SUPABASE_KEY=

LOG_LEVEL=INFO
ARTIFACTS_DIR=./artifacts
